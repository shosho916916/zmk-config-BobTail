#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 4
#define SCROLL 5
#define NUM 6
#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        shift_tab {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;
        };

        lang {
            bindings = <&kp LANG1>;
            key-positions = <18 19>;
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    macros {
        new_macro1: new_macro1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp NUMBER_1 &kp LANGUAGE_1>;
            label = "NEW_MACRO1";
        };

        new_macro2: new_macro2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp NUMBER_2 &kp LANGUAGE_1>;
            label = "NEW_MACRO2";
        };

        new_macro3: new_macro3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp NUMBER_3 &kp LANGUAGE_1>;
            label = "NEW_MACRO3";
        };

        new_macro4: new_macro4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp NUMBER_4 &kp LANG1>;
            label = "NEW_MACRO4";
        };

        new_macro5: new_macro5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp N5 &kp LANGUAGE_1>;
            label = "NEW_MACRO5";
        };

        new_macro6: new_macro6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp NUMBER_6 &kp LANGUAGE_1>;
            label = "NEW_MACRO6";
        };

        new_macro7: new_macro7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp N7 &kp LANGUAGE_1>;
            label = "NEW_MACRO7";
        };

        new_macro8: new_macro8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp N8 &kp LANGUAGE_1>;
            label = "NEW_MACRO8";
        };

        new_macro9: new_macro9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp N9>;
            label = "NEW_MACRO9";
        };

        new_macro0: new_macro0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp N0 &kp LANGUAGE_1>;
            label = "NEW_MACRO0";
        };

        new_macrojikan: new_macrojikan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_1 &kp SINGLE_QUOTE>;
            label = "NEW_MACROJIKAN";
        };

        new_macrohidarikakko: new_macrohidarikakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp LS(N8) &kp LANGUAGE_1>;
            label = "NEW_MACROHIDARIKAKKO";
        };

        new_macromigikakko: new_macromigikakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp LS(N9) &kp LANGUAGE_1>;
            label = "NEW_MACROMIGIKAKKO";
        };

        new_macroniduke: new_macroniduke {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LANGUAGE_2 &kp SLASH>;
            label = "NEW_MACRONIDUKE";
        };

        new_macrotab: new_macrotab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT &kp TAB>;
            label = "NEW_MACROTAB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q    &kp L    &kp U        &kp COMMA       &kp DOT                                              &kp F        &kp W  &kp R  &lt 5 Y  &lt 5 P
&kp E    &kp I    &kp A        &kp O           &kp MINUS          &none            &kp RIGHT_GUI    &kp K        &kp T  &kp N  &kp S    &kp H
&kp Z    &kp X    &kp C        &kp V           &kp RIGHT_CONTROL  &kp LALT         &kp LA(LC(TAB))  &kp G        &kp D  &kp M  &kp J    &kp B
&kp ESC  &kp TAB  &kp RA(TAB)  &kp LEFT_SHIFT  &kp LANGUAGE_1     &lt 2 SPACE      &kp BACKSPACE    &lt 1 ENTER                         &kp DELETE
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        FUNCTION {
            bindings = <
&kp HASH    &kp AT         &kp RBKT               &kp BACKSLASH        &kp AMPERSAND                                  &kp F2  &kp HOME  &kp UP_ARROW  &kp END          &none
&kp DOLLAR  &kp AMPERSAND  &new_macrohidarikakko  &new_macromigikakko  &none          &none          &kp PRINTSCREEN  &kp F7  &kp LEFT  &kp DOWN      &kp RIGHT_ARROW  &none
&none       &kp LBKT       &kp RIGHT_BRACE        &kp LS(BACKSLASH)    &none          &trans         &none            &kp F8  &kp EXCL  &kp QUESTION  &none            &none
&kp ESCAPE  &trans         &trans                 &trans               &trans         &kp SPACE      &kp BACKSPACE    &none                                            &kp DELETE
            >;
        };

        NUM {
            bindings = <
&none       &none      &kp LESS_THAN  &kp GREATER_THAN  &kp PERCENT                                         &new_macrojikan   &new_macro1  &new_macro2  &new_macro3  &kp PLUS
&none       &kp UNDER  &kp PLUS       &kp MINUS         &kp DOUBLE_QUOTES  &none             &kp LEFT_GUI   &new_macroniduke  &new_macro4  &new_macro5  &new_macro6  &new_macro0
&none       &none      &none          &none             &kp RS(INT1)       &kp LEFT_GUI      &kp DOT        &kp COMMA         &new_macro7  &new_macro8  &new_macro9  &kp MINUS
&kp ESCAPE  &none      &trans         &kp LEFT_SHIFT    &none              &none             &kp BACKSPACE  &kp ENTER                                                &kp DEL
            >;
        };

        ARROW {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&none      &none      &kp LC(E)  &kp LC(T)       &none                                 &trans  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)  &mo 5   &mo 5
&kp LC(A)  &kp LC(X)  &kp LC(V)  &kp LC(C)       &none             &trans      &trans  &trans  &mkp MB1            &mkp MB2             &trans  &trans
&none      &none      &none      &kp LEFT_SHIFT  &kp LEFT_CONTROL  &trans      &trans  &trans  &trans              &trans               &trans  &trans
&none      &none      &none      &none           &to 0             &trans      &trans  &trans                                                   &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                                &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &kp LEFT_CONTROL  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
